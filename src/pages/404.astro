---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { site, links } from "../data/content";
---

<Layout title={`Page not found — ${site.name}`} description="This page doesn't exist." noindex>
  <div id="top"></div>
  <Nav />
  <main id="main" class="container not-found">
    <p class="code">404</p>
    <h1 class="title">This page doesn't exist.</h1>
    <p class="body">The link may be out of date, or the address may have a typo.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">
        Back to the homepage <Icon name="arrow-right" size={16} />
      </a>
      <a class="btn btn-ghost" href={`mailto:${links.email}`}>
        <Icon name="mail" size={16} /> Email me
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    padding-top: 120px;
    padding-bottom: 120px;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: var(--tracking-wider);
    color: var(--cobalt-300);
    margin-bottom: 12px;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .body {
    font-size: 18px;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
