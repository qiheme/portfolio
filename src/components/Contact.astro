---
import Icon from "./Icon.astro";
import { links } from "../data/content";
---

<section id="contact" class="container contact-wrap" aria-labelledby="contact-title">
  <div class="band">
    <div>
      <h2 id="contact-title" class="band-title">Let's talk.</h2>
      <p class="band-sub">Email is the fastest way to reach me. I'm also on LinkedIn.</p>
    </div>
    <div class="band-actions">
      <a class="btn btn-primary" href={`mailto:${links.email}`}>
        <Icon name="mail" size={16} />
        {links.email}
      </a>
      <a class="btn btn-ghost" href={links.linkedin} rel="noopener">
        <Icon name="linkedin" size={16} /> LinkedIn
      </a>
    </div>
  </div>
</section>

<style>
  .contact-wrap {
    padding-bottom: 72px;
  }
  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    padding: 36px 40px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(37, 99, 235, 0.3);
    background: linear-gradient(160deg, #0c1322, #060a12);
  }
  .band-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.5vw, 34px);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-bottom: 6px;
  }
  .band-sub {
    font-size: 16px;
    color: var(--text-secondary);
  }
  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 640px) {
    .band {
      padding: 28px 22px;
    }
    .band-actions,
    .band-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
